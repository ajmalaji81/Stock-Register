# cp .env.production.example .env.production  and fill it in. Never commit .env.production.
DOMAIN=godown.ajmalaji.tech
# 32+ random characters: openssl rand -hex 32   (also signs invoice share links)
AUTH_SECRET=

# Dodo Payments (Lifetime Pro). Leave blank to run without checkout: the Upgrade button then shows a message.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID=
LIFETIME_PRICE_CENTS=2900

# Country header set by your host/proxy for regional pricing (Caddy strips visitor-sent copies).
PPP_COUNTRY_HEADER=x-vercel-ipcountry
