// SQLite for local dev. To move to Postgres/Supabase: change provider to "postgresql"
// and point DATABASE_URL at the Supabase connection string, then `npm run db:push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  plan         String    @default("FREE") // FREE | PRO
  proSince     DateTime?
  trialEndsAt  DateTime? // Pro features free until this moment
  avatar       String? // profile picture as a small data: URL (256x256 JPEG, resized in the browser)
  createdAt    DateTime  @default(now())

  // Business profile (printed on invoices; state decides CGST+SGST vs IGST)
  businessName  String @default("")
  gstin         String @default("")
  address       String @default("")
  state         String @default("") // Indian state name, e.g. "Tamil Nadu"
  phone         String @default("")
  invoicePrefix String @default("INV")
  invoiceTerms  String @default("")
  bankDetails   String @default("")

  godowns       Godown[]
  items         Item[]
  entries       LedgerEntry[]
  payments      Payment[]
  parties       Party[]
  vouchers      Voucher[]
  partyPayments PartyPayment[]
  expenses      Expense[]
  staff         StaffMember[]
  activities    ActivityLog[]
}

model Godown {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stocks   Stock[]
  entries  LedgerEntry[]
  vouchers Voucher[]

  @@unique([userId, name])
}

model Item {
  id            String   @id @default(cuid())
  userId        String
  name          String
  sku           String
  category      String   @default("")
  unit          String   @default("pcs")
  purchasePrice Float    @default(0)
  salePrice     Float    @default(0)
  minStockAlert Float    @default(0)
  hsn           String   @default("")
  gstRate       Float    @default(0) // percent, e.g. 5, 12, 18
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stocks  Stock[]
  entries LedgerEntry[]
  lines   VoucherLine[]

  @@unique([userId, sku])
}

// Current quantity of one item in one godown. Only changed by ledger entries.
model Stock {
  itemId   String
  godownId String
  quantity Float  @default(0)

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  godown Godown @relation(fields: [godownId], references: [id], onDelete: Cascade)

  @@id([itemId, godownId])
}

// The khata. Immutable: entries are never edited or deleted (except when their item is deleted).
model LedgerEntry {
  id           String   @id @default(cuid())
  userId       String
  itemId       String
  godownId     String
  type         String // OPENING | IN | OUT | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT
  qtyIn        Float    @default(0)
  qtyOut       Float    @default(0)
  balance      Float // godown balance of this item after the entry
  itemBalance  Float // total balance of this item (all godowns) after the entry
  rate         Float    @default(0)
  party        String   @default("")
  remarks      String   @default("")
  transferId   String?
  refType      String? // "VOUCHER" when created by a bill
  refId        String? // Voucher.id
  actorName    String   @default("") // who made the entry (owner or staff name)
  date         String // YYYY-MM-DD, as entered by the user
  createdAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  godown Godown @relation(fields: [godownId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, itemId, createdAt])
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  dodoPaymentId String   @unique
  status        String
  amount        Int // smallest currency unit, as reported by Dodo
  currency      String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Webhook ids we've already processed (Dodo may retry deliveries).
model WebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

// ---------------- Parties, billing, payments, expenses ----------------
// All business rows hang off the OWNER's User.id ("account"). Staff act on the owner's account.

model Party {
  id             String   @id @default(cuid())
  userId         String
  name           String
  type           String   @default("CUSTOMER") // CUSTOMER | SUPPLIER | BOTH
  phone          String   @default("")
  email          String   @default("")
  gstin          String   @default("")
  state          String   @default("")
  address        String   @default("")
  openingBalance Float    @default(0) // + they owe us (receivable), - we owe them (payable)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vouchers Voucher[]
  payments PartyPayment[]

  @@unique([userId, name])
}

// One table for every trading document. Only SALE / PURCHASE / SALE_RETURN / PURCHASE_RETURN
// move stock and party balances; QUOTATION / SALES_ORDER / PURCHASE_ORDER / CHALLAN don't.
model Voucher {
  id            String   @id @default(cuid())
  userId        String
  kind          String // SALE | PURCHASE | SALE_RETURN | PURCHASE_RETURN | QUOTATION | SALES_ORDER | PURCHASE_ORDER | CHALLAN
  number        String
  date          String // YYYY-MM-DD
  partyId       String?
  godownId      String
  status        String   @default("OPEN") // OPEN | CONVERTED | CLOSED | CANCELLED
  gstEnabled    Boolean  @default(true)
  interState    Boolean  @default(false) // true -> IGST, false -> CGST + SGST
  placeOfSupply String   @default("")
  subtotal      Float    @default(0) // sum of taxable values
  discount      Float    @default(0)
  cgst          Float    @default(0)
  sgst          Float    @default(0)
  igst          Float    @default(0)
  roundOff      Float    @default(0)
  total         Float    @default(0)
  costTotal     Float    @default(0) // purchase cost of lines, for profit
  notes         String   @default("")
  sourceId      String? // converted from this voucher (quotation / order / challan)
  createdBy     String   @default("") // actor name
  createdAt     DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  party    Party?         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  godown   Godown         @relation(fields: [godownId], references: [id], onDelete: Restrict)
  lines    VoucherLine[]
  payments PartyPayment[]

  @@unique([userId, kind, number])
  @@index([userId, kind, date])
}

model VoucherLine {
  id          String @id @default(cuid())
  voucherId   String
  itemId      String
  description String @default("")
  qty         Float
  rate        Float // price per unit before tax
  discountPct Float  @default(0)
  taxRate     Float  @default(0)
  taxable     Float  @default(0)
  tax         Float  @default(0)
  amount      Float  @default(0) // taxable + tax
  costRate    Float  @default(0) // item purchase price at the time (profit)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)
}

model PartyPayment {
  id        String   @id @default(cuid())
  userId    String
  partyId   String
  direction String // IN = received from party, OUT = paid to party
  amount    Float
  mode      String   @default("CASH") // CASH | BANK | UPI | CHEQUE
  date      String
  reference String   @default("")
  notes     String   @default("")
  voucherId String?
  createdBy String   @default("")
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  party   Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([userId, partyId, date])
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  category  String
  amount    Float
  mode      String   @default("CASH") // CASH | BANK | UPI | CHEQUE
  date      String
  notes     String   @default("")
  createdBy String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ---------------- Staff & activity ----------------

model StaffMember {
  id           String   @id @default(cuid())
  userId       String // owner account
  name         String
  email        String   @unique
  passwordHash String
  role         String // SALES | SALES_PURCHASE | STORE_ADMIN
  avatar       String? // profile picture (data: URL)
  godownIds    String   @default("[]") // JSON array of godown ids; [] = all godowns
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String // owner account
  actorId   String
  actorName String
  action    String // e.g. "item.create", "voucher.create"
  detail    String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
