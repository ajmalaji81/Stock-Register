# Copy to .env.production on the server and fill in. Never commit .env.production.
# DATABASE_URL is set by docker-compose.yml (SQLite on the db-data volume).

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out and invalidates invoice share links.
AUTH_SECRET=""

# Public address (used for Dodo return URLs and WhatsApp invoice links)
NEXT_PUBLIC_APP_URL="https://godownbook.ajmalaji.tech"

# Dodo Payments — use test_mode until you're ready to take real money
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_WEBHOOK_SECRET=""
DODO_PRODUCT_ID=""

# Lifetime price in USD cents, before PPP
LIFETIME_PRICE_CENTS="2900"

# Country header for PPP pricing. Caddy strips x-vercel-ipcountry from visitors, so with this
# default everyone pays the base price (safe). Behind Cloudflare, use cf-ipcountry (see DEPLOY.md).
PPP_COUNTRY_HEADER="x-vercel-ipcountry"
PPP_DEV_COUNTRY=""
